<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:96Yi0H2OIiFqmwUzKxg6sbRSkpjGo4P+4J4tZGd8L3g="/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <!-- Dedicated test database: RefreshDatabase runs migrate:fresh, which
             would otherwise wipe the dev database configured in .env. -->
        <env name="DB_DATABASE" value="tydal_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="AWS_BUCKET" value="test-bucket"/>
        <env name="AWS_DEFAULT_REGION" value="us-east-1"/>
        <!-- Dummy static credentials so the S3 client builds object URLs offline
             (e.g. File::url accessor) instead of falling back to the EC2
             instance-metadata credential lookup, which fails in CI. -->
        <env name="AWS_ACCESS_KEY_ID" value="testing"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="testing"/>
    </php>
</phpunit>
