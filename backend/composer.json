{
    "name": "tydal/backend",
    "type": "project",
    "description": "TYDAL - the typed Digital Asset Layer: a multi-tenant, schema-driven semantic knowledge system built around semantic Vaults for AI agents",
    "keywords": ["laravel", "digital-assets", "semantic-layer", "semantic-vaults", "schema-driven", "typed-resources", "mcp", "ai-agents", "semantic-search", "embeddings", "knowledge-management"],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "elasticsearch/elasticsearch": "^9.3",
        "james-heinrich/getid3": "^1.9",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.32",
        "predis/predis": "^3.4",
        "spatie/laravel-medialibrary": "^11.0",
        "vaites/php-apache-tika": "^1.4",
        "vinkla/hashids": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": [
            "vendor/bin/pest"
        ],
        "pint": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
