{
  "name": "@tydal/client",
  "version": "1.5.0",
  "description": "Shared TypeScript client for the TYDAL REST API — the single transport layer for every TYDAL surface (management SPA, MCP server, vault renderer apps).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eonity-org/tydal.git",
    "directory": "client"
  },
  "keywords": [
    "tydal",
    "vault",
    "semantic",
    "dam",
    "api-client",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
