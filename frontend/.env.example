# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Name of the cookie that holds the login token (default JWT). Cookies are
# shared across ports on one host, so installations side by side on one host
# need different names; configure.sh --infra=shared sets it to tydal_NAME_jwt.
VITE_AUTH_COOKIE=JWT

# Feature Flags
VITE_SHOW_DAM_ORGANIZATIONS=true
