{
  "name": "@tydal/vault-mcp",
  "version": "1.0.0",
  "description": "TYDAL Vault MCP server — a vault-scoped, read-only Model Context Protocol surface: a customer's AI agent consumes one vault's projection (identity, chunks, minted links) and nothing else",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tydal-vault-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
