# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Feature Flags
VITE_SHOW_DAM_ORGANIZATIONS=true

# Dev-server ports aren't set in this file: tools/deploy/start.sh exports
# TYDAL_HTTP_PORT / TYDAL_VITE_PORT (8000 / 3005 by default) from the root .env
# and frontend/vite.config.ts reads them. configure.sh --infra=shared (#23)
# offsets both and rewrites VITE_API_BASE_URL above to the offset app port.
