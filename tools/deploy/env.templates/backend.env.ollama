###### AI configured with OLLAMA
# Min VARS to personalize:
# APP_KEY,TYDAL_SUPERADMIN_PASSWORD
# AI Active stack: TEXT=ollama | VISION=ollama | EMBEDDING=ollama(1024d)
######

APP_NAME="TYDAL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tydal
DB_USERNAME=tydal
DB_PASSWORD=secret

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
MEDIA_DISK=public
#MEDIA_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@tydal.com"
MAIL_FROM_NAME="${APP_NAME}"

## AWS S3 / MinIO Configuration
#FILESYSTEM_DISK=s3
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
#AWS_BUCKET=
#AWS_ENDPOINT=
#AWS_USE_PATH_STYLE_ENDPOINT=true

## Apache Tika — text extraction server
TIKA_HOST=http://localhost:9998
TIKA_TIMEOUT=120

## Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
#ELASTICSEARCH_API_KEY=
#ELASTICSEARCH_USERNAME=
#ELASTICSEARCH_PASSWORD=
#ELASTICSEARCH_SHARDS=1
#ELASTICSEARCH_REPLICAS=0
# RAG chunk retrieval score filters (Ask Aity / Q&A endpoint)
# rag_min_score: absolute floor — chunks below this score are excluded from LLM context.
# rag_score_ratio: relative filter — keeps only chunks within this fraction of the best score.
ELASTICSEARCH_RAG_MIN_SCORE=0.72 # default — lower if too aggressive
ELASTICSEARCH_RAG_SCORE_RATIO=0.88 # relative filter (filler results)
# Minimum k-NN cosine similarity score for hybrid search (ES reports as (1+cosine)/2).
# 0.7 ≈ cosine=0.4 — raise to reduce false semantic matches, lower to widen recall.
ELASTICSEARCH_HYBRID_MIN_KNN_SCORE=0.85

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
SANCTUM_EXPIRATION=60
SANCTUM_TOKEN_NAME=api_token

# Maximum File Upload Size (in MB - default 300MB)
MAX_MEDIA_FILE_SIZE=300

# SUPERADMIN seeding (Production/Minimal/Superadmin seeders all read these)
# Ships with a fixed DEV password so re-seeding (cleanup.sh) keeps the same
# login. CHANGE IT for anything exposed — if left blank, a strong random
# password is generated and printed once during seeding instead.

TYDAL_SUPERADMIN_EMAIL=superadmin@tydal.test
TYDAL_SUPERADMIN_PASSWORD=super123



######## AI CONFIGURATION ########
# Active stack: TEXT=ollama | VISION=ollama | EMBEDDING=ollama(1024d)
#
# Three independent subsystems, each with its own driver switch: TEXT
# (LLM_TEXT_DRIVER — RAG Q&A + auto-tagging), VISION (LLM_VISION_DRIVER —
# image analysis) and EMBEDDINGS (EMBEDDING_DRIVER — RAG vector search).
# Any of claude/anthropicproxy/zai/openai/gemini/ollama can serve TEXT or
# VISION (see LlmDriverFactory) — each provider's credentials sit under the
# subsystem section it's configured for below; point a *_DRIVER at a
# provider configured under a different section and just reuse that block.

#### 1. TEXT — LLM_TEXT_DRIVER ####
LLM_TEXT_DRIVER=ollama # claude | anthropicproxy | gemini | zai | openai | ollama
# For a Z.ai key (not a real Anthropic sk-ant- one): LLM_TEXT_DRIVER=anthropicproxy with
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic — same request shape as 'claude', same
# class, just a name that makes the proxy visible without also reading ANTHROPIC_BASE_URL.
# Prefer LLM_TEXT_DRIVER=zai + the Zai block below instead for Z.ai's native (differently-shaped) API.
#LLM_MAX_CONTEXT_CHARS=40000
#LLM_META_CHUNK_MAX_CHARS=600

## Claude / Anthropic  [INACTIVE — also selectable for VISION]
#ANTHROPIC_AUTH_TOKEN takes precedence over ANTHROPIC_API_KEY.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=60

## Zai AI — native API, NOT the anthropicproxy route above  [unused — also selectable for VISION]
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4 # native endpoint — not /api/anthropic, that 404s here
# ZAI_API_KEY=
# ZAI_MODEL=glm-5.3 # REQUIRED, no built-in default — unset breaks AI Services status AND every chat/vision call
# ZAI_MAX_TOKENS=1024
# ZAI_TIMEOUT=60

## OpenAI  [unused — also selectable for VISION]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com # API root — the backend appends /v1/chat/completions
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=60

## Ollama — TEXT half of the shared local backend  [ACTIVE; connection settings are under COMMON below]
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_LLM_MAX_TOKENS=4096
OLLAMA_REPEAT_PENALTY=1.1   # default, safe start; try 1.3 if loops still occur
OLLAMA_TEMPERATURE=0.1      # optional; lower = more deterministic JSON output


#### 2. VISION — LLM_VISION_DRIVER ####
LLM_VISION_DRIVER=ollama # ollama | gemini | claude | anthropicproxy | zai | openai — defaults to LLM_TEXT_DRIVER when unset

## Gemini  [INACTIVE]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=60
# Claude / Zai / OpenAI can serve VISION too — reuse their blocks under TEXT above; nothing new to add here.

## Ollama — VISION half of the shared local backend  [ACTIVE]
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_VISION_MAX_TOKENS=4096
OLLAMA_VISION_TIMEOUT=360 # separate from the shared OLLAMA_TIMEOUT below — multimodal inference is slower


#### 3. EMBEDDINGS — EMBEDDING_DRIVER ####
# CHUNKS vs EMBEDDINGS: a CHUNK is a slice of extracted text (in WORDS); an
# EMBEDDING is the vector an embed model produces FROM a chunk. Document →
# chunks (text) → embeddings (vectors) → k-NN search. A chunk bigger than the
# model's token context makes Ollama reject it: HTTP 400 "input length exceeds
# the context length". Match EMBEDDING_MAX_CHUNK_WORDS to OLLAMA_EMBED_MODEL —
# token-dense / non-English text (codes, numbers, accents) tokenizes far
# heavier than its word count, so size conservatively and rely on the hard
# char cap (EMBEDDING_OLLAMA_MAX_INPUT_CHARS, under Ollama below) as the real
# backstop: nomic-embed-text → 2048-tok context → ~400 words;
# mxbai-embed-large → 512-tok context → ~150 words (256 overflows dense text).
EMBEDDING_DRIVER=ollama # ollama | voyage | jina
EMBEDDING_DIMENSIONS=1024 # must match the model & Elasticsearch — requires --recreate + search:embed to change
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHUNK_WORDS=256 # mxbai (512 tok): drop to ~150 for dense text; nomic (2048 tok): 400 ok
EMBEDDING_CHUNK_OVERLAP=50    # words shared between consecutive chunks for context continuity

## Jina  [INACTIVE]
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3 # 1024 embedding size for Elastic
JINA_TIMEOUT=30

## Voyage  [unused]
# VOYAGE_API_KEY=
# VOYAGE_EMBED_MODEL=voyage-3
# VOYAGE_TIMEOUT=30

## Ollama — EMBEDDINGS half of the shared local backend  [ACTIVE]
OLLAMA_EMBED_MODEL=mxbai-embed-large # Elastic vector size 1024 (EMBEDDING_DIMENSIONS)
#OLLAMA_EMBED_MODEL=nomic-embed-text # Elastic vector size 768 (EMBEDDING_DIMENSIONS)
# Ollama's own truncate flag is unreliable for token-dense multibyte text (can still
# 400), so it's a safety net only — EMBEDDING_OLLAMA_MAX_INPUT_CHARS is the real guarantee.
OLLAMA_EMBED_TRUNCATE=true
# Hard char cap applied before the embed request. Sized for mxbai-embed-large
# (512 tok ≈ 1450 chars on dense text; 1200 leaves margin) — raise for larger-
# context models (nomic ≈ 2048 tok) or set 0 to disable.
EMBEDDING_OLLAMA_MAX_INPUT_CHARS=1200

## Audio transcription (IT WON'T WORK YET — PENDING)
# WHISPER_DRIVER=local  # requires faster-whisper container (see docker-compose)
# WHISPER_DRIVER=openai # uses OpenAI Whisper API (OPENAI_API_KEY required)


#### 4. COMMON — shared across TEXT, VISION and EMBEDDINGS ####

## Ollama connection  [ACTIVE] — one shared instance backs whichever subsystems above are set to `ollama`
OLLAMA_HOST=http://localhost:11434 # use 'http://ollama:11434' inside Docker network
OLLAMA_CONNECT_TIMEOUT=10          # TCP connect timeout; fail fast if Ollama is unreachable
OLLAMA_TIMEOUT=120                 # request timeout for TEXT + EMBEDDINGS calls (VISION has its own OLLAMA_VISION_TIMEOUT)

## Feature toggles
AUTOTAGGING_ENABLED=true # text-based tag suggestions for documents/PDFs (uses LLM_TEXT_DRIVER)
AUTOTAGGING_MAX_CHARS=6000 # max extracted-text characters sent to the LLM (~1 500 tokens)
AUTOTAGGING_MAX_TAGS=8 # max tags the LLM is asked to generate per resource
AI_VISION_ENABLED=true # image analysis (name/description/tags) via LLM_VISION_DRIVER
AITY_RAG_STRICT_MODE=true # true = RAG only uses human-confirmed metadata; false = unconfirmed AI suggestions are folded in
AI_DEBUG=true # write full pipeline traces (prompts, context, metadata) to storage/logs/ai-activity.log — keep false in production
